{{- /*
Like ingress-nginx, which these routes replace: Envoy closes an idle connection to a pod after 60 seconds (nginx's
upstream-keepalive-timeout), so apps whose keep-alive timeout is longer close none that Envoy might still send a
request on (Envoy's default is an hour, and a request sent as the app closes gets a 503). And a client can't set
X-Forwarded-Host: nginx replaced it with the request's host, Envoy passes it on, and apps such as Rails read it as
the host.
*/ -}}
apiVersion: projectcontour.io/v1
kind: HTTPProxy
metadata:
  name: {{.Service.Name}}
  namespace: {{.Namespace}}
  labels:
    app: {{.App}}
    service: {{.Service.Name}}
    system: convox
    type: service
    {{- range keyValue .Service.Labels}}
    {{ yamlScalar .Key }}: {{ yamlQuote .Value }}
    {{- end}}
  annotations:
    convox.com/idles: "{{.Idles}}"
    convox.com/backend-protocol: {{ yamlQuote .Service.Port.Scheme }}
    {{- range $k, $v := .Annotations}}
    {{ yamlScalar $k }}: {{ safe $v }}
    {{- end}}
spec:
  ingressClassName: {{.IngressClassName}}
  virtualhost:
    fqdn: {{ safe .Host }}
    {{- if or .Service.Certificate.Id .ConvoxDomainTLS}}
    tls:
      secretName: {{if .Service.Certificate.Id}}{{ yamlScalar .Service.Certificate.Id }}{{else}}cert-{{.Service.Name}}{{end}}
    {{- end}}
    {{- if .WhitelistCIDRs}}
    ipAllowPolicy:
    {{- range .WhitelistCIDRs}}
    - cidr: {{ safe . }}
      source: {{if $.ProxyProtocol}}Remote{{else}}Peer{{end}}
    {{- end}}
    {{- end}}
  routes:
  - conditions:
    - prefix: /
    enableWebsockets: true
    {{- if not .Service.Tls.Redirect}}
    permitInsecure: true
    {{- end}}
    services:
    - name: {{.Service.Name}}
      port: {{.Service.Port.Port}}
      {{- if .BackendProtocol}}
      protocol: {{.BackendProtocol}}
      {{- end}}
    timeoutPolicy:
      {{- if .Service.Timeout}}
      response: "{{.TimeoutResponse}}"
      idle: "{{.TimeoutIdle}}"
      {{- end}}
      idleConnection: 60s
    requestHeadersPolicy:
      remove:
      - X-Forwarded-Host
    {{- if .RateLimitRPS}}
    rateLimitPolicy:
      local:
        requests: {{.RateLimitRPS}}
        unit: second
    {{- end}}
    {{- if .Service.Sticky}}
    loadBalancerPolicy:
      strategy: Cookie
    {{- end}}
{{- range $i, $d := .Service.Domains}}
---
apiVersion: projectcontour.io/v1
kind: HTTPProxy
metadata:
  name: {{$.Service.Name}}-domain-{{$i}}
  namespace: {{$.Namespace}}
  labels:
    app: {{$.App}}
    service: {{$.Service.Name}}
    system: convox
    type: service
spec:
  ingressClassName: {{$.IngressClassName}}
  virtualhost:
    fqdn: {{ safe $d }}
    {{- if or $.Service.Certificate.Id $.DomainTLS}}
    tls:
      secretName: {{if $.Service.Certificate.Id}}{{ yamlScalar $.Service.Certificate.Id }}{{else}}cert-{{$.Service.Name}}-domains{{end}}
    {{- end}}
    {{- if $.WhitelistCIDRs}}
    ipAllowPolicy:
    {{- range $.WhitelistCIDRs}}
    - cidr: {{ safe . }}
      source: {{if $.ProxyProtocol}}Remote{{else}}Peer{{end}}
    {{- end}}
    {{- end}}
  routes:
  - conditions:
    - prefix: /
    enableWebsockets: true
    {{- if not $.Service.Tls.Redirect}}
    permitInsecure: true
    {{- end}}
    services:
    - name: {{$.Service.Name}}
      port: {{$.Service.Port.Port}}
      {{- if $.BackendProtocol}}
      protocol: {{$.BackendProtocol}}
      {{- end}}
    timeoutPolicy:
      {{- if $.Service.Timeout}}
      response: "{{$.TimeoutResponse}}"
      idle: "{{$.TimeoutIdle}}"
      {{- end}}
      idleConnection: 60s
    requestHeadersPolicy:
      remove:
      - X-Forwarded-Host
    {{- if $.RateLimitRPS}}
    rateLimitPolicy:
      local:
        requests: {{$.RateLimitRPS}}
        unit: second
    {{- end}}
    {{- if $.Service.Sticky}}
    loadBalancerPolicy:
      strategy: Cookie
    {{- end}}
{{- end}}
